     }
 
+    // Which grammar the side decoration is composed in. Auto builds every
+    // family as a candidate and keeps the one that scores best; picking a
+    // family narrows the candidates to it. Like the motif family, this does
+    // not switch the decoration on.
+    QMenu *composition = itashaMenu_->addMenu(i18n::t("&Composition Family"));
+    composition->setStatusTip(i18n::t(
+        "Which grammar the side decoration is composed in - bed, flow, density, "
+        "empty space. Auto builds every family and keeps the best-scoring one."));
+    addLiveryEntry(composition, i18n::t("&Auto (score picks)"),
+                   QStringLiteral("family"),
+                   i18n::t("Build every family as a candidate and keep the best"));
+    for (const CompositionFamily &fam : kCompositionFamilies) {
+        addLiveryEntry(composition, i18n::t(fam.text), QStringLiteral("family"),
+                       i18n::t(fam.tip),
+                       {QStringLiteral("--composition"), QString::fromLatin1(fam.name)});
+    }
+
+    itashaMenu_->addSeparator();
+    // Text is optional and off by default - the Itasha vocabulary has no
+    // letters unless someone types a name. The dialog runs the "text" action;
+    // the engine draws the name as a custom decal from bundled fonts and steps
+    // down to the game font, then to nothing, as the layer budget shrinks.
+    QAction *text = itashaMenu_->addAction(i18n::t("Character Name &Text..."));
+    text->setStatusTip(i18n::t(
+        "Put the character's name (and a title) into the decoration as a "
+        "wordmark - a custom decal from bundled fonts, or the game font when "
+        "layers run short"));
+    connect(text, &QAction::triggered, this, &MainWindow::showItashaTextDialog);
+    itashaLiveryActions_.push_back(text);
+    addLiveryEntry(itashaMenu_, i18n::t("Remove Text"),
+                   QStringLiteral("no-text"),
+                   i18n::t("Take the name text out of the decoration"));

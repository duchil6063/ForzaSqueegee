+void MainWindow::showItashaTextDialog() {
+    QSettings settings;
+    settings.beginGroup(QLatin1String(kItashaTextKey));
+
+    QDialog dialog(this);
+    dialog.setWindowTitle(i18n::t("Character Name Text"));
+    auto *layout = new QVBoxLayout(&dialog);
+    auto *intro = new QLabel(i18n::t(
+        "The name goes into the decoration as a wordmark. Spaces, case and "
+        "punctuation are kept as typed; \\n breaks a line."), &dialog);
+    intro->setWordWrap(true);
+    layout->addWidget(intro);
+
+    auto *form = new QFormLayout;
+    layout->addLayout(form);
+    auto *name = new QLineEdit(settings.value(QStringLiteral("main")).toString(),
+                               &dialog);
+    name->setPlaceholderText(QStringLiteral("Asuka Langley"));
+    form->addRow(i18n::t("Character name:"), name);
+    auto *title = new QLineEdit(settings.value(QStringLiteral("sub")).toString(),
+                                &dialog);
+    title->setPlaceholderText(QStringLiteral("EVANGELION"));
+    form->addRow(i18n::t("Title / tagline (optional):"), title);
+
+    const auto combo = [&](const char *const *items, int count, const char *key) {
+        auto *box = new QComboBox(&dialog);
+        for (int i = 0; i < count; ++i) {
+            box->addItem(i18n::t(QString::fromLatin1(items[i])),
+                         QString::fromLatin1(items[i]));
+        }
+        const int at = box->findData(settings.value(QString::fromLatin1(key)).toString());
+        box->setCurrentIndex(at < 0 ? 0 : at);
+        return box;
+    };
+    QComboBox *style = combo(kTextStyles, int(std::size(kTextStyles)), "style");
+    style->setToolTip(i18n::t(
+        "auto lets the composition family choose - script for soft beds, racing "
+        "and techno for diagonal and motorsport, brush and graffiti for splash. "
+        "game uses the game's own font vinyl."));
+    form->addRow(i18n::t("Style:"), style);
+    QComboBox *placement = combo(kTextPlacements, int(std::size(kTextPlacements)),
+                                 "placement");
+    placement->setToolTip(i18n::t(
+        "auto puts the wordmark beside the character on the sides; rear, hood, "
+        "roof and window pin it to that panel instead."));
+    form->addRow(i18n::t("Placement:"), placement);
+    QComboBox *priority = combo(kTextPriorities, int(std::size(kTextPriorities)),
+                                "priority");
+    priority->setToolTip(i18n::t(
+        "high keeps the name even if scattered motifs have to go; low gives it "
+        "half the layer budget."));
+    form->addRow(i18n::t("Priority:"), priority);
+    QComboBox *outline = combo(kTextTri, int(std::size(kTextTri)), "outline");
+    form->addRow(i18n::t("Outline:"), outline);
+    QComboBox *shadow = combo(kTextTri, int(std::size(kTextTri)), "shadow");
+    form->addRow(i18n::t("Shadow:"), shadow);
+    auto *maxLayers = new QSpinBox(&dialog);
+    maxLayers->setRange(0, 3000);
+    maxLayers->setSpecialValueText(i18n::t("no cap"));
+    maxLayers->setValue(settings.value(QStringLiteral("maxLayers"), 0).toInt());
+    maxLayers->setToolTip(i18n::t(
+        "Layers the text may use. 0 lets the panel budget decide - the engine "
+        "steps down from a full custom decal to a simpler one, then to the game "
+        "font, then drops the text."));
+    form->addRow(i18n::t("Layer cap:"), maxLayers);
+    auto *fallback = new QCheckBox(
+        i18n::t("Fall back to the game font when layers run short"), &dialog);
+    fallback->setChecked(settings.value(QStringLiteral("fallback"), true).toBool());
+    layout->addWidget(fallback);
+
+    auto *buttons = new QDialogButtonBox(
+        QDialogButtonBox::Ok | QDialogButtonBox::Cancel, &dialog);
+    connect(buttons, &QDialogButtonBox::accepted, &dialog, &QDialog::accept);
+    connect(buttons, &QDialogButtonBox::rejected, &dialog, &QDialog::reject);
+    layout->addWidget(buttons);
+    name->setFocus();
+
+    if (dialog.exec() != QDialog::Accepted) {
+        return;
+    }
+    const QString main = name->text();
+    if (main.trimmed().isEmpty()) {
+        QMessageBox::information(this, i18n::t("Itasha"),
+                                 i18n::t("Type a character name first."));
+        return;
+    }
+    settings.setValue(QStringLiteral("main"), main);
+    settings.setValue(QStringLiteral("sub"), title->text());
+    settings.setValue(QStringLiteral("style"), style->currentData().toString());
+    settings.setValue(QStringLiteral("placement"), placement->currentData().toString());
+    settings.setValue(QStringLiteral("priority"), priority->currentData().toString());
+    settings.setValue(QStringLiteral("outline"), outline->currentData().toString());
+    settings.setValue(QStringLiteral("shadow"), shadow->currentData().toString());
+    settings.setValue(QStringLiteral("maxLayers"), maxLayers->value());
+    settings.setValue(QStringLiteral("fallback"), fallback->isChecked());
+    settings.endGroup();
+
+    // The strings go to the engine untouched - QProcess passes each argument
+    // as one item, so spaces survive without any quoting here.
+    QStringList extra{QStringLiteral("--text"), main};
+    if (!title->text().trimmed().isEmpty()) {
+        extra << QStringLiteral("--subtext") << title->text();
+    }
+    extra << QStringLiteral("--text-style") << style->currentData().toString()
+          << QStringLiteral("--text-placement") << placement->currentData().toString()
+          << QStringLiteral("--text-priority") << priority->currentData().toString()
+          << QStringLiteral("--text-outline") << outline->currentData().toString()
+          << QStringLiteral("--text-shadow") << shadow->currentData().toString()
+          << QStringLiteral("--game-text-fallback")
+          << (fallback->isChecked() ? QStringLiteral("on") : QStringLiteral("off"));
+    if (maxLayers->value() > 0) {
+        extra << QStringLiteral("--text-max-layers")
+              << QString::number(maxLayers->value());
+    }
+    runItashaAction(QStringLiteral("text"), extra);
+}

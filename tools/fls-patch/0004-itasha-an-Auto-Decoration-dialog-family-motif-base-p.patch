+void MainWindow::showItashaDecorationDialog() {
+    if (itashaCommand().isEmpty()) {
+        runItashaAction(QStringLiteral("decoration"));   // shows the "no engine" note
+        return;
+    }
+    const QJsonObject state = itashaState();
+    const QJsonObject textState = state.value(QStringLiteral("text")).toObject();
+    QSettings settings;
+    settings.beginGroup(QLatin1String(kItashaTextKey));
+
+    QDialog dialog(this);
+    dialog.setWindowTitle(i18n::t("Auto Decoration"));
+    auto *layout = new QVBoxLayout(&dialog);
+    auto *intro = new QLabel(i18n::t(
+        "The decoration is composed around the artwork you placed - the "
+        "artwork itself never moves. Auto lets the engine build every "
+        "candidate and keep the best-scoring one."), &dialog);
+    intro->setWordWrap(true);
+    layout->addWidget(intro);
+
+    const auto pickCombo = [&](QComboBox *box, const QString &value) {
+        const int at = box->findData(value);
+        box->setCurrentIndex(at < 0 ? 0 : at);
+    };
+
+    // ---- Composition ----
+    auto *compGroup = new QGroupBox(i18n::t("Composition"), &dialog);
+    auto *compForm = new QFormLayout(compGroup);
+    auto *composition = new QComboBox(compGroup);
+    composition->addItem(i18n::t("Auto (score picks)"), QStringLiteral("auto"));
+    for (const CompositionFamily &fam : kCompositionFamilies) {
+        composition->addItem(i18n::t(QString::fromLatin1(fam.text)).remove(QLatin1Char('&')),
+                             QString::fromLatin1(fam.name));
+        composition->setItemData(composition->count() - 1, i18n::t(fam.tip),
+                                 Qt::ToolTipRole);
+    }
+    pickCombo(composition, state.value(QStringLiteral("family")).toString(
+                               QStringLiteral("auto")));
+    composition->setToolTip(i18n::t(
+        "Which grammar the side decoration is composed in - bed, flow, density, "
+        "empty space. Auto builds every family and keeps the best-scoring one."));
+    compForm->addRow(i18n::t("Composition family:"), composition);
+    auto *motif = new QComboBox(compGroup);
+    motif->addItem(i18n::t("Auto (the design picks)"), QStringLiteral("auto"));
+    for (const char *family : kMotifFamilies) {
+        const QString name = QString::fromLatin1(family);
+        motif->addItem(i18n::t(name.at(0).toUpper() + name.mid(1)), name);
+    }
+    pickCombo(motif, state.value(QStringLiteral("motif")).toString(QStringLiteral("auto")));
+    motif->setToolTip(i18n::t(
+        "Which family the scattered decoration draws from. The design's theme "
+        "colour picks one; a character you know is better picked by hand."));
+    compForm->addRow(i18n::t("Motif family:"), motif);
+    layout->addWidget(compGroup);
+
+    // ---- Base paint ----
+    auto *paintGroup = new QGroupBox(i18n::t("Base Paint"), &dialog);
+    auto *paintRow = new QHBoxLayout(paintGroup);
+    auto *paintMode = new QComboBox(paintGroup);
+    paintMode->addItem(i18n::t("From the design"), QStringLiteral("auto"));
+    paintMode->addItem(i18n::t("Colour I pick"), QStringLiteral("pick"));
+    auto *swatch = new QPushButton(paintGroup);
+    swatch->setToolTip(i18n::t("Paint the car a colour you choose"));
+    QColor chosen = Qt::white;
+    const QJsonArray paintRgb = state.value(QStringLiteral("paint")).toArray();
+    if (paintRgb.size() == 3) {
+        chosen = QColor(paintRgb.at(0).toInt(), paintRgb.at(1).toInt(),
+                        paintRgb.at(2).toInt());
+        pickCombo(paintMode, QStringLiteral("pick"));
+    }
+    const auto showSwatch = [&]() {
+        swatch->setText(chosen.name(QColor::HexRgb).toUpper());
+        swatch->setStyleSheet(QStringLiteral("background:%1;color:%2;")
+                                  .arg(chosen.name(QColor::HexRgb),
+                                       chosen.lightness() < 128
+                                           ? QStringLiteral("white")
+                                           : QStringLiteral("black")));
+        swatch->setEnabled(paintMode->currentData().toString() == QStringLiteral("pick"));
+    };
+    showSwatch();
+    connect(paintMode, &QComboBox::currentIndexChanged, &dialog, [&]() { showSwatch(); });
+    connect(swatch, &QPushButton::clicked, &dialog, [&]() {
+        const QColor got = QColorDialog::getColor(chosen, &dialog, i18n::t("Base Paint"));
+        if (got.isValid()) {
+            chosen = got;
+            showSwatch();
+        }
+    });
+    paintRow->addWidget(paintMode, 1);
+    paintRow->addWidget(swatch, 1);
+    paintGroup->setToolTip(i18n::t(
+        "The single colour the whole car is painted. It is paint, not vinyl - "
+        "it costs no layers and carries a gloss no decal can."));
+    layout->addWidget(paintGroup);
+
+    // ---- Text ----
+    auto *textGroup = new QGroupBox(i18n::t("Character Name Text"), &dialog);
+    textGroup->setCheckable(true);
+    textGroup->setChecked(textState.value(QStringLiteral("enabled")).toBool(false));
+    textGroup->setToolTip(i18n::t(
+        "Put the character's name (and a title) into the decoration as a "
+        "wordmark - the game's own font, or shapes fitted to a bundled font "
+        "when that engine is asked for"));
+    auto *textLayout = new QVBoxLayout(textGroup);
+    auto *textIntro = new QLabel(i18n::t(
+        "Spaces, case and punctuation are kept as typed; \\n breaks a line."),
+        textGroup);
+    textIntro->setWordWrap(true);
+    textLayout->addWidget(textIntro);
+    auto *form = new QFormLayout;
+    textLayout->addLayout(form);
+    const auto stateOr = [&](const char *key, const QString &fallback) {
+        const QJsonValue v = textState.value(QString::fromLatin1(key));
+        return v.isString() && !v.toString().isEmpty()
+                   ? v.toString()
+                   : settings.value(QString::fromLatin1(key), fallback).toString();
+    };
+    auto *name = new QLineEdit(stateOr("main", QString()), textGroup);
+    name->setPlaceholderText(QStringLiteral("Asuka Langley"));
+    form->addRow(i18n::t("Character name:"), name);
+    auto *title = new QLineEdit(stateOr("sub", QString()), textGroup);
+    title->setPlaceholderText(QStringLiteral("EVANGELION"));
+    form->addRow(i18n::t("Title / tagline (optional):"), title);
+    const auto combo = [&](const char *const *items, int count, const char *key) {
+        auto *box = new QComboBox(textGroup);
+        for (int i = 0; i < count; ++i) {
+            box->addItem(i18n::t(QString::fromLatin1(items[i])),
+                         QString::fromLatin1(items[i]));
+        }
+        pickCombo(box, stateOr(key, QString::fromLatin1(items[0])));
+        return box;
+    };
+    QComboBox *style = combo(kTextStyles, int(std::size(kTextStyles)), "style");
+    style->setToolTip(i18n::t(
+        "auto lets the composition family choose - script for soft beds, racing "
+        "and techno for diagonal and motorsport, brush and graffiti for splash. "
+        "Each style picks the game font that matches it."));
+    form->addRow(i18n::t("Style:"), style);
+    QComboBox *placement = combo(kTextPlacements, int(std::size(kTextPlacements)),
+                                 "placement");
+    placement->setToolTip(i18n::t(
+        "auto puts the wordmark beside the character on the sides; rear, hood, "
+        "roof and window pin it to that panel instead."));
+    form->addRow(i18n::t("Placement:"), placement);
+    QComboBox *priority = combo(kTextPriorities, int(std::size(kTextPriorities)),
+                                "priority");
+    priority->setToolTip(i18n::t(
+        "high keeps the name even if scattered motifs have to go; low gives it "
+        "half the layer budget."));
+    form->addRow(i18n::t("Priority:"), priority);
+    QComboBox *outline = combo(kTextTri, int(std::size(kTextTri)), "outline");
+    form->addRow(i18n::t("Outline:"), outline);
+    QComboBox *shadow = combo(kTextTri, int(std::size(kTextTri)), "shadow");
+    form->addRow(i18n::t("Shadow:"), shadow);
+    auto *maxLayers = new QSpinBox(textGroup);
+    maxLayers->setRange(0, 3000);
+    maxLayers->setSpecialValueText(i18n::t("no cap"));
+    maxLayers->setValue(textState.value(QStringLiteral("max_layers")).toInt(
+        settings.value(QStringLiteral("maxLayers"), 0).toInt()));
+    maxLayers->setToolTip(i18n::t(
+        "Layers the text may use. 0 lets the panel budget decide - the game "
+        "font is one layer per letter, and the text goes only when even that "
+        "does not fit."));
+    form->addRow(i18n::t("Layer cap:"), maxLayers);
+    auto *fallback = new QCheckBox(
+        i18n::t("Fall back to the game font when shape decals do not fit"), textGroup);
+    fallback->setChecked(textState.value(QStringLiteral("allow_fallback_to_game_text"))
+                             .toBool(settings.value(QStringLiteral("fallback"), true).toBool()));
+    textLayout->addWidget(fallback);
+    layout->addWidget(textGroup);
+
+    auto *buttons = new QDialogButtonBox(
+        QDialogButtonBox::Ok | QDialogButtonBox::Cancel, &dialog);
+    buttons->button(QDialogButtonBox::Ok)->setText(i18n::t("Compose"));
+    connect(buttons, &QDialogButtonBox::accepted, &dialog, &QDialog::accept);
+    connect(buttons, &QDialogButtonBox::rejected, &dialog, &QDialog::reject);
+    layout->addWidget(buttons);
+
+    if (dialog.exec() != QDialog::Accepted) {
+        return;
+    }
+    QStringList extra{QStringLiteral("--composition"), composition->currentData().toString(),
+                      QStringLiteral("--family"), motif->currentData().toString()};
+    if (paintMode->currentData().toString() == QStringLiteral("pick")) {
+        extra << QStringLiteral("--color") << chosen.name(QColor::HexRgb);
+    } else {
+        extra << QStringLiteral("--auto-paint");
+    }
+    const QString main = name->text();
+    if (textGroup->isChecked() && !main.trimmed().isEmpty()) {
+        settings.setValue(QStringLiteral("main"), main);
+        settings.setValue(QStringLiteral("sub"), title->text());
+        settings.setValue(QStringLiteral("style"), style->currentData().toString());
+        settings.setValue(QStringLiteral("placement"), placement->currentData().toString());
+        settings.setValue(QStringLiteral("priority"), priority->currentData().toString());
+        settings.setValue(QStringLiteral("outline"), outline->currentData().toString());
+        settings.setValue(QStringLiteral("shadow"), shadow->currentData().toString());
+        settings.setValue(QStringLiteral("maxLayers"), maxLayers->value());
+        settings.setValue(QStringLiteral("fallback"), fallback->isChecked());
+        // The strings go to the engine untouched - QProcess passes each
+        // argument as one item, so spaces survive without any quoting here.
+        extra << QStringLiteral("--text") << main;
+        if (!title->text().trimmed().isEmpty()) {
+            extra << QStringLiteral("--subtext") << title->text();
+        }
+        extra << QStringLiteral("--text-style") << style->currentData().toString()
+              << QStringLiteral("--text-placement") << placement->currentData().toString()
+              << QStringLiteral("--text-priority") << priority->currentData().toString()
+              << QStringLiteral("--text-outline") << outline->currentData().toString()
+              << QStringLiteral("--text-shadow") << shadow->currentData().toString()
+              << QStringLiteral("--game-text-fallback")
+              << (fallback->isChecked() ? QStringLiteral("on") : QStringLiteral("off"));
+        if (maxLayers->value() > 0) {
+            extra << QStringLiteral("--text-max-layers")
+                  << QString::number(maxLayers->value());
+        }
+    } else {
+        extra << QStringLiteral("--no-text");
+    }
+    settings.endGroup();
+    runItashaAction(QStringLiteral("decorate"), extra);
+}

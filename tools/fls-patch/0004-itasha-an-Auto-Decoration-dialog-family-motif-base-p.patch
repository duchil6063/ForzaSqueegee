+bool MainWindow::saveProjectForItasha(QString *projectPath) {
+    // The engine works on a saved project, so an unsaved one goes to the work
+    // folder first and stays there - reopening it later is the user's business.
+    QString path = projectJsonPath_;
+    if (path.isEmpty()) {
+        path = QDir(itashaWorkDir()).filePath(
+            mw_detail::safeGroupName(state_->project_.name) + QStringLiteral(".3so"));
+    }
+    QString error;
+    if (!saveProjectJson(path, &error)) {
+        QMessageBox::critical(this, i18n::t("Itasha"), error);
+        return false;
+    }
+    projectJsonPath_ = path;
+    *projectPath = path;
+    return true;
+}
+
+QJsonObject MainWindow::itashaState() {
+    // The recipe the engine keeps beside the project - what the dialog is
+    // prefilled from. Empty when there is no engine or no project yet.
+    const QStringList command = itashaCommand();
+    if (command.isEmpty() || state_ == nullptr || !state_->hasProject()) {
+        return {};
+    }
+    QString projectPath;
+    if (!saveProjectForItasha(&projectPath)) {
+        return {};
+    }
+    QStringList arguments = command.mid(1);
+    arguments << QStringLiteral("state") << QStringLiteral("--project") << projectPath;
+    QSettings settings;
+    const QString cwd = settings.value(QLatin1String(kItashaCwdKey)).toString();
+    QProcess process;
+    if (!cwd.isEmpty()) {
+        process.setWorkingDirectory(cwd);
+    }
+    process.start(command.first(), arguments);
+    if (!process.waitForFinished(kItashaTimeoutMs) || process.exitCode() != 0) {
+        return {};
+    }
+    const QByteArray out = process.readAllStandardOutput();
+    // The state is the last JSON object in the output (notes may precede it).
+    const int brace = out.indexOf('{');
+    if (brace < 0) {
+        return {};
+    }
+    return QJsonDocument::fromJson(out.mid(brace)).object();
+}

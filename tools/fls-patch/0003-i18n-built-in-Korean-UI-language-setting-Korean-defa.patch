+    {"This livery targets \"%1\".\n\nChoose your Forza game install folder so the "
+     "matching car and its paint materials can be loaded automatically? "
+     "(You can also set it later under Settings.)",
+     "이 리버리의 대상 차는 \"%1\"입니다.\n\n맞는 차와 도색 재질을 자동으로 "
+     "불러올 수 있도록 Forza 게임 설치 폴더를 지정할까요? (나중에 설정에서 "
+     "지정할 수도 있습니다.)"},
+    {"Split into %1 (%2 layers) and %3 (%4 layers)%5",
+     "분할 완료: %1(레이어 %2개) · %3(레이어 %4개)%5"},
+    {" - %1 layer(s) the line crossed went into both",
+     " — 선에 걸친 레이어 %1개는 양쪽에 들어갔습니다"},
+    {"\nOne side is empty - move the line into the artwork.",
+     "\n한쪽이 비어 있습니다 — 선을 그림 안쪽으로 옮기세요."},
+};
+
+const QHash<QString, QString> &table() {
+    static const QHash<QString, QString> map = [] {
+        QHash<QString, QString> result;
+        result.reserve(int(sizeof(kTable) / sizeof(kTable[0])));
+        for (const Entry &entry : kTable) {
+            result.insert(QString::fromUtf8(entry.en), QString::fromUtf8(entry.ko));
+        }
+        return result;
+    }();
+    return map;
+}
+
+QString &cachedLanguage() {
+    // Read once, on first use - always after main() has set the organization
+    // and application names QSettings needs.
+    static QString language = [] {
+        const QString value = QSettings().value(
+            QLatin1String(kLanguageSettingsKey)).toString().trimmed().toLower();
+        return value == QLatin1String("en") ? QStringLiteral("en")
+                                            : QStringLiteral("ko");
+    }();
+    return language;
+}
+
+} // namespace
+
+QString languageCode() {
+    return cachedLanguage();
+}
+
+void setLanguageCode(const QString &code) {
+    const QString normalized = code.trimmed().toLower() == QLatin1String("en")
+        ? QStringLiteral("en") : QStringLiteral("ko");
+    QSettings().setValue(QLatin1String(kLanguageSettingsKey), normalized);
+    cachedLanguage() = normalized;
+}
+
+bool koreanActive() {
+    return languageCode() != QLatin1String("en");
+}
+
+QString t(const char *english) {
+    return t(QString::fromUtf8(english));
+}
+
+QString t(const QString &english) {
+    if (!koreanActive()) {
+        return english;
+    }
+    return table().value(english, english);
+}
+
+} // namespace gui::i18n
diff --git a/src/gui/i18n.h b/src/gui/i18n.h
new file mode 100644
index 0000000..e440002
--- /dev/null
+++ b/src/gui/i18n.h
@@ -0,0 +1,29 @@
+// UI language support. The editor ships with a built-in Korean translation;
+// the table lives in i18n.cpp and maps the English source strings to Korean.
+//
+// Usage: wrap a user-visible string literal in i18n::t("...") at the place it
+// is built or shown. When Korean is active and the string is in the table the
+// Korean text comes back; otherwise the English string passes through
+// unchanged, so a string the table does not know is never lost. The QString
+// overload serves strings that arrive at a display point from elsewhere
+// (engine error messages, tips loaded from JSON).
+//
+// The language is stored in QSettings under "ui/language" ("ko" or "en") and
+// defaults to Korean. It is read once, on first use, so a change applies on
+// the next launch - the settings dialog offers the restart.
+
+#pragma once
+
+#include <QString>
+
+namespace gui::i18n {
+
+// "ko" (default) or "en".
+QString languageCode();
+void setLanguageCode(const QString &code);
+bool koreanActive();
+
+QString t(const char *english);
+QString t(const QString &english);
+
+} // namespace gui::i18n

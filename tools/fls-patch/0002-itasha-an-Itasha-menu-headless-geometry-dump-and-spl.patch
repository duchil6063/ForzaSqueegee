diff --git a/src/gui/state/editor_state_split.cpp b/src/gui/state/editor_state_split.cpp
new file mode 100644
index 0000000..8a77138
--- /dev/null
+++ b/src/gui/state/editor_state_split.cpp
@@ -0,0 +1,195 @@
+// Splitting a selection into two groups at a line.
+//
+// This is how artwork is carried across a panel seam by hand: put the line on
+// the seam, split, and drag one of the two groups onto the neighbouring panel.
+//
+// A game shape cannot be cut in half, so a shape the line crosses is copied -
+// the original stays in side A, the copy goes into side B. Both halves then
+// hold the whole shape, and each panel draws only its own part, so nothing
+// opens up at the seam. The clearance (SplitLine::margin) widens that overlap
+// inwards, which is what covers a seam that really sits a little further in
+// than the line does.
+//
+// The selection is flattened: whatever nesting it had is dissolved into the two
+// new groups, with every group frame above a leaf folded into the leaf. Two
+// groups is the answer the split gives, and keeping a half-preserved tree
+// underneath them would make the result depend on how the design happened to be
+// grouped before.
+//
+// A group is one contiguous run of siblings, so the two sides come out stacked
+// rather than interleaved: every layer of side A now draws under every layer of
+// side B. That is what splitting into groups means and there is no tree shape
+// that avoids it. It costs nothing in the case this exists for - the two halves
+// go onto two panels and never overlap - but it does show if both halves are
+// left on one panel and their edges cross.
+
+#include "editor_state.h"
+
+#include "matrix_math.h"
+
+#include <algorithm>
+
+namespace gui {
+namespace {
+
+void flattenInto(std::unique_ptr<fls::scene::Layer> node,
+                 const fls::Matrix3 &ancestorFrame,
+                 std::vector<std::unique_ptr<fls::scene::Layer>> &out) {
+    if (!node) {
+        return;
+    }
+    const fls::Matrix3 frame =
+        fls::detail::multiply(ancestorFrame, node->transform.matrix());
+    if (node->kind() != fls::scene::LayerKind::Group) {
+        node->transform = fls::decomposeTransform2D(frame);
+        out.push_back(std::move(node));
+        return;
+    }
+    auto *group = static_cast<fls::scene::Group *>(node.get());
+    while (!group->children.empty()) {
+        flattenInto(group->takeAt(0), frame, out);
+    }
+}
+
+// Fresh ids, minted here rather than through uniqueLayerId(): the tree is in
+// pieces while the split runs, so the index cache cannot answer "is this taken"
+// and asking it twice would hand out the same id twice.
+class IdMinter {
+public:
+    explicit IdMinter(QSet<QString> taken)
+        : taken_(std::move(taken)) {
+    }
+
+    QString next(const QString &prefix) {
+        QString id;
+        do {
+            id = QStringLiteral("%1_%2").arg(prefix).arg(++counter_);
+        } while (taken_.contains(id));
+        taken_.insert(id);
+
+        return id;
+    }
+
+private:
+    QSet<QString> taken_;
+    int counter_ = 0;
+};
+
+} // namespace
+
+SplitOutcome EditorState::splitEntriesAtLine(const QVector<QString> &entryIds,
+                                             const QSet<QString> &sideA,
+                                             const QSet<QString> &sideB,
+                                             const QString &nameA,
+                                             const QString &nameB) {
+    SplitOutcome outcome;
+    if (!hasProject_) {
+        outcome.error = QStringLiteral("No project is open.");
+        return outcome;
+    }
+    QVector<QString> entries = normalizeEntrySelection(entryIds);
+    if (entries.isEmpty()) {
+        outcome.error = QStringLiteral("Nothing is selected.");
+        return outcome;
+    }
+    const ProjectIndexCache &cache = projectIndexCache();
+    const QString parentId = cache.parentByChild.value(entries.front());
+    for (const QString &entryId : entries) {
+        if (cache.parentByChild.value(entryId) != parentId) {
+            outcome.error = QStringLiteral(
+                "Select layers that sit side by side - a split makes two groups "
+                "in one place, so it cannot reach across two of them.");
+            return outcome;
+        }
+        if (entryHasLockedLayer(entryId)) {
+            outcome.error = QStringLiteral("The selection contains locked layers.");
+            return outcome;
+        }
+        if (entryIsGuide(entryId)) {
+            outcome.error = QStringLiteral("Guide layers cannot be split.");
+            return outcome;
+        }
+    }
+    fls::scene::Group *parent = groupForId(parentId);
+    if (parent == nullptr) {
+        outcome.error = QStringLiteral("The selection has no parent group.");
+        return outcome;
+    }
+    std::sort(entries.begin(), entries.end(), [&](const QString &a, const QString &b) {
+        return cache.orderByChild.value(a, 0) < cache.orderByChild.value(b, 0);
+    });
+
+    // Count first, mutate second: a split that would leave one side empty is
+    // not a split, and finding that out halfway through would leave the project
+    // holding a group with nothing in it.
+    QVector<QString> leafIds;
+    for (const QString &entryId : entries) {
+        leafIds += leafLayerIdsForEntry(entryId);
+    }
+    if (leafIds.size() < 2) {
+        outcome.error = QStringLiteral(
+            "Select two or more layers - a split needs something to put on each "
+            "side.");
+        return outcome;
+    }
+    int countA = 0;
+    int countB = 0;
+    for (const QString &id : leafIds) {
+        const bool inA = sideA.contains(id);
+        const bool inB = sideB.contains(id);
+        countA += inA || !inB ? 1 : 0;
+        countB += inB ? 1 : 0;
+    }
+    if (countA == 0 || countB == 0) {
+        outcome.error = QStringLiteral(
+            "One side of the line is empty - move the line into the artwork.");
+        return outcome;
+    }
+
+    const int insertAt = cache.orderByChild.value(entries.front(), 0);
+    std::vector<std::unique_ptr<fls::scene::Layer>> leaves;
+    for (int i = entries.size() - 1; i >= 0; --i) {
+        std::vector<std::unique_ptr<fls::scene::Layer>> taken;
+        flattenInto(takeEntry(entries[i]), fls::Matrix3{}, taken);
+        leaves.insert(leaves.begin(), std::make_move_iterator(taken.begin()),
+                      std::make_move_iterator(taken.end()));
+    }
+
+    IdMinter minter(QSet<QString>(cache.nodes.keyBegin(), cache.nodes.keyEnd()));
+    auto groupA = std::make_unique<fls::scene::Group>();
+    groupA->id = minter.next(QStringLiteral("group"));
+    groupA->name = nameA;
+    auto groupB = std::make_unique<fls::scene::Group>();
+    groupB->id = minter.next(QStringLiteral("group"));
+    groupB->name = nameB;
+    QSet<QString> selected;
+    for (auto &leaf : leaves) {
+        const QString id = leaf->id;
+        const bool inB = sideB.contains(id);
+        const bool inA = sideA.contains(id) || !inB;
+        if (inA && inB) {
+            std::unique_ptr<fls::scene::Layer> copy = leaf->clone();
+            copy->id = minter.next(QStringLiteral("layer"));
+            selected.insert(copy->id);
+            groupB->append(std::move(copy));
+            ++outcome.copied;
+        }
+        selected.insert(id);
+        if (inA) {
+            groupA->append(std::move(leaf));
+        } else {
+            groupB->append(std::move(leaf));
+        }
+    }
+    outcome.sideA = static_cast<int>(groupA->children.size());
+    outcome.sideB = static_cast<int>(groupB->children.size());
+    parent->insert(insertAt, std::move(groupB));
+    parent->insert(insertAt, std::move(groupA));
+    selectedLayerIds_ = selected;
+    invalidateProjectIndexCache();
+    outcome.ok = true;
+
+    return outcome;
+}

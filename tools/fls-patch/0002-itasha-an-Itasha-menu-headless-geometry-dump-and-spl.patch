+// ─────────────────────── Itasha geometry dump ───────────────────────
+//
+// The livery panels are planar projections: a world point lands on side i at
+//
+//     px = xSign*xScale * world[xAxis]   u = (px - projMin.x) / projSpan.x
+//     py = ySign*yScale * world[yAxis]   v = (py - projMin.y) / projSpan.y
+//     canvas  = (left + (right-left)*u, top + (bottom-top)*v)
+//     section = liverySectionPoint(side, i, canvas)
+//
+// which is closed form and needs no geometry. The inverse does: a point on the
+// panel only names a ray, and the car surface decides where that ray lands. So
+// the dump carries, per side, a raster over the mask box holding the remaining
+// world axis (the depth) of the front-most facing surface. With it a point on
+// panel A resolves to a world point and projects onto panel B, which is what
+// carrying artwork across a panel seam needs.
+
+namespace {
+
+struct ItashaDepthRaster {
+    int width = 0;
+    int height = 0;
+    std::vector<float> depth;      // NaN where no surface is seen
+};
+
+ItashaDepthRaster rasterizeSideDepth(int sideIndex,
+                                     const fls::LiverySide &side,
+                                     const std::vector<fls::CarMesh> &meshes,
+                                     const QVector2D &projectionMinimum,
+                                     const QVector2D &projectionMaximum,
+                                     int depthAxis) {
+    ItashaDepthRaster raster;
+    const float spanX = projectionMaximum.x() - projectionMinimum.x();
+    const float spanY = projectionMaximum.y() - projectionMinimum.y();
+    const float boxWidth = std::abs(side.right - side.left);
+    const float boxHeight = std::abs(side.bottom - side.top);
+    if (spanX <= 0.0f || spanY <= 0.0f || boxWidth < 1.0f || boxHeight < 1.0f) {
+        return raster;
+    }
+    // One cell per mask canvas unit, the grid section coordinates are measured
+    // in, clamped so an odd panel cannot blow the dump up.
+    raster.width = std::clamp(static_cast<int>(std::lround(boxWidth)), 8, 2048);
+    raster.height = std::clamp(static_cast<int>(std::lround(boxHeight)), 8, 2048);
+    const size_t cells = static_cast<size_t>(raster.width) * raster.height;
+    raster.depth.assign(cells, std::numeric_limits<float>::quiet_NaN());
+
+    const int geometrySide = kMaskSlotGeometrySides[sideIndex];
+    // The panel is looked at along the remaining axis; its sign says whether the
+    // visible surface is the one with the larger or the smaller depth.
+    const QVector3D facingVector = kFacing[geometrySide];
+    const float facingDepth = depthAxis == 0
+        ? facingVector.x()
+        : (depthAxis == 1 ? facingVector.y() : facingVector.z());
+    const bool keepGreater = facingDepth >= 0.0f;
+    std::vector<float> best(cells, keepGreater
+                                       ? -std::numeric_limits<float>::max()
+                                       : std::numeric_limits<float>::max());
+
+    const auto rasterPoint = [&](const fls::ModelVec3 &world) {
+        const float px = sideAxisScale(side, true) * axisOf(world, side.xAxis);
+        const float py = sideAxisScale(side, false) * axisOf(world, side.yAxis);
+        return QPointF(
+            (px - projectionMinimum.x()) / spanX * (raster.width - 1),
+            (py - projectionMinimum.y()) / spanY * (raster.height - 1));
+    };
+
+    for (const fls::CarMesh &mesh : meshes) {
+        if ((projectionSidesForMesh(mesh) & (1 << geometrySide)) == 0) {
+            continue;
+        }
+        for (size_t i = 0; i + 2 < mesh.indices.size(); i += 3) {
+            QPointF corner[3];
+            float cornerDepth[3] = {0.0f, 0.0f, 0.0f};
+            bool valid = true;
+            bool haveNormals = true;
+            float facing = 0.0f;
+            for (int c = 0; c < 3; ++c) {
+                const quint32 index = mesh.indices[i + c];
+                if (index >= mesh.positions.size()) {
+                    valid = false;
+                    break;
+                }
+                const fls::ModelVec3 world = mirroredCarSpace(
+                    mesh.boneTransform.transformPoint(mesh.positions[index]));
+                corner[c] = rasterPoint(world);
+                cornerDepth[c] = axisOf(world, depthAxis);
+                if (index < mesh.normals.size()) {
+                    const fls::ModelVec3 normal = mirroredCarSpace(
+                        mesh.boneTransform.transformVector(mesh.normals[index]));
+                    facing += normal.x * facingVector.x()
+                        + normal.y * facingVector.y()
+                        + normal.z * facingVector.z();
+                } else {
+                    haveNormals = false;
+                }
+            }
+            if (!valid || (haveNormals && facing <= 0.0f)) {
+                continue;
+            }
+            const double area =
+                (corner[1].x() - corner[0].x()) * (corner[2].y() - corner[0].y())
+                - (corner[2].x() - corner[0].x()) * (corner[1].y() - corner[0].y());
+            if (std::abs(area) < 1e-9) {
+                continue;
+            }
+            int x0 = std::max(0, static_cast<int>(std::floor(
+                std::min({corner[0].x(), corner[1].x(), corner[2].x()}))));
+            int x1 = std::min(raster.width - 1, static_cast<int>(std::ceil(
+                std::max({corner[0].x(), corner[1].x(), corner[2].x()}))));
+            int y0 = std::max(0, static_cast<int>(std::floor(
+                std::min({corner[0].y(), corner[1].y(), corner[2].y()}))));
+            int y1 = std::min(raster.height - 1, static_cast<int>(std::ceil(
+                std::max({corner[0].y(), corner[1].y(), corner[2].y()}))));
+            for (int y = y0; y <= y1; ++y) {
+                for (int x = x0; x <= x1; ++x) {
+                    const double sx = x;
+                    const double sy = y;
+                    const double w0 =
+                        ((corner[1].x() - sx) * (corner[2].y() - sy)
+                         - (corner[2].x() - sx) * (corner[1].y() - sy)) / area;
+                    const double w1 =
+                        ((corner[2].x() - sx) * (corner[0].y() - sy)
+                         - (corner[0].x() - sx) * (corner[2].y() - sy)) / area;
+                    const double w2 = 1.0 - w0 - w1;
+                    if (w0 < -1e-6 || w1 < -1e-6 || w2 < -1e-6) {
+                        continue;
+                    }
+                    const float value = static_cast<float>(
+                        w0 * cornerDepth[0] + w1 * cornerDepth[1]
+                        + w2 * cornerDepth[2]);
+                    const size_t cell = static_cast<size_t>(y) * raster.width + x;
+                    if (keepGreater ? value > best[cell] : value < best[cell]) {
+                        best[cell] = value;
+                        raster.depth[cell] = value;
+                    }
+                }
+            }
+        }
+    }
+    return raster;
+}
+
+} // namespace
+
+bool dumpItashaGeometry(const fls::CarModel &model,
+                        const fls::LiveryMaskSet &masks,
+                        const QString &path,
+                        QString *error) {
+    const auto fail = [error](const QString &message) {
+        if (error != nullptr) {
+            *error = message;
+        }
+        return false;
+    };
+    if (!masks.valid()) {
+        return fail(QStringLiteral("livery masks are not loaded"));
+    }
+    const std::vector<fls::CarMesh> &meshes = model.liveryProjectionMeshes.empty()
+        ? model.meshes
+        : model.liveryProjectionMeshes;
+    if (meshes.empty()) {
+        return fail(QStringLiteral("car model has no meshes"));
+    }
+    const LiveryProjectionData projection = buildLiveryProjectionData(model, masks);
+
+    QJsonArray sideArray;
+    std::vector<ItashaDepthRaster> rasters(fls::kLiverySideCount);
+    for (int sideIndex = 0; sideIndex < fls::kLiverySideCount; ++sideIndex) {
+        const fls::LiverySide &side = masks.sides[sideIndex];
+        QJsonObject meta;
+        meta.insert(QStringLiteral("slot"), sideIndex);
+        meta.insert(QStringLiteral("name"), side.maskName);
+        meta.insert(QStringLiteral("valid"), side.valid);
+        if (!side.valid) {
+            sideArray.append(meta);
+            continue;
+        }
+        const int depthAxis = 3 - side.xAxis - side.yAxis;
+        meta.insert(QStringLiteral("left"), side.left);
+        meta.insert(QStringLiteral("right"), side.right);
+        meta.insert(QStringLiteral("top"), side.top);
+        meta.insert(QStringLiteral("bottom"), side.bottom);
+        meta.insert(QStringLiteral("x_origin"), side.xOrigin);
+        meta.insert(QStringLiteral("y_origin"), side.yOrigin);
+        meta.insert(QStringLiteral("x_axis"), side.xAxis);
+        meta.insert(QStringLiteral("y_axis"), side.yAxis);
+        meta.insert(QStringLiteral("depth_axis"), depthAxis);
+        meta.insert(QStringLiteral("x_axis_scale"), sideAxisScale(side, true));
+        meta.insert(QStringLiteral("y_axis_scale"), sideAxisScale(side, false));
+        meta.insert(QStringLiteral("rotation_deg"), side.rotationDeg);
+        meta.insert(QStringLiteral("transpose"), transposedLiverySide(sideIndex));
+        meta.insert(QStringLiteral("flip_x"),
+                    sideIndex == 4 || sideIndex == 6 || sideIndex == 7
+                        || sideIndex == 10);
+        meta.insert(QStringLiteral("flip_y"),
+                    sideIndex == 4 || sideIndex == 7 || sideIndex == 10);
+        QJsonArray projectionMin;
+        projectionMin.append(projection.minimum[sideIndex].x());
+        projectionMin.append(projection.minimum[sideIndex].y());
+        QJsonArray projectionMax;
+        projectionMax.append(projection.maximum[sideIndex].x());
+        projectionMax.append(projection.maximum[sideIndex].y());
+        meta.insert(QStringLiteral("projection_min"), projectionMin);
+        meta.insert(QStringLiteral("projection_max"), projectionMax);
+        if (depthAxis >= 0 && depthAxis <= 2 && side.xAxis != side.yAxis) {
+            rasters[sideIndex] = rasterizeSideDepth(
+                sideIndex, side, meshes, projection.minimum[sideIndex],
+                projection.maximum[sideIndex], depthAxis);
+        }
+        meta.insert(QStringLiteral("raster_width"), rasters[sideIndex].width);
+        meta.insert(QStringLiteral("raster_height"), rasters[sideIndex].height);
+        sideArray.append(meta);
+    }
+
+    QJsonObject root;
+    root.insert(QStringLiteral("format"), QStringLiteral("fls_itasha_geometry"));
+    root.insert(QStringLiteral("version"), 1);
+    root.insert(QStringLiteral("media"), model.mediaName);
+    root.insert(QStringLiteral("source"), model.sourcePath);
+    root.insert(QStringLiteral("canvas_half_width"), fls::kLiveryCanvasHalfWidth);
+    root.insert(QStringLiteral("canvas_half_height"), fls::kLiveryCanvasHalfHeight);
+    root.insert(QStringLiteral("sides"), sideArray);
+    const QByteArray header = QJsonDocument(root).toJson(QJsonDocument::Compact);
+
+    QFile file(path);
+    if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+        return fail(QStringLiteral("could not write %1").arg(path));
+    }
+    const auto writeU32 = [&file](quint32 value) {
+        const char bytes[4] = {static_cast<char>(value & 0xff),
+                               static_cast<char>((value >> 8) & 0xff),
+                               static_cast<char>((value >> 16) & 0xff),
+                               static_cast<char>((value >> 24) & 0xff)};
+        file.write(bytes, 4);
+    };
+    file.write("FSITG1\0\0", 8);
+    writeU32(static_cast<quint32>(header.size()));
+    file.write(header);
+    for (const ItashaDepthRaster &raster : rasters) {
+        writeU32(static_cast<quint32>(raster.width));
+        writeU32(static_cast<quint32>(raster.height));
+        if (raster.depth.empty()) {
+            writeU32(0);
+            continue;
+        }
+        const QByteArray plain(
+            reinterpret_cast<const char *>(raster.depth.data()),
+            static_cast<qsizetype>(raster.depth.size() * sizeof(float)));
+        // qCompress prefixes a big-endian uncompressed size before the zlib
+        // stream; readers skip those four bytes.
+        const QByteArray packed = qCompress(plain, 6);
+        writeU32(static_cast<quint32>(packed.size()));
+        file.write(packed);
+    }
+    if (file.error() != QFileDevice::NoError) {
+        return fail(file.errorString());
+    }
+    file.close();
+    return true;
+}
+
 } // namespace gui

+// Split Selection at a Line: the panel beside the line, and running the split.
+//
+// Two halves of one job. The canvas owns the line - it is what gets dragged and
+// what knows where every shape sits - and this owns the numbers next to it: the
+// angle, where the line sits, and the clearance. The panel stays open while the
+// line is moved so the tally beneath the fields keeps answering "what would this
+// split give me", and only [Split] commits anything.
+//
+// Splitting is how artwork is carried across a panel seam by hand, now that the
+// engine no longer joins across seams on its own. Put the line on the seam,
+// split, and drag one of the two groups onto the neighbouring panel. A shape the
+// line crosses cannot be cut in half, so it is copied into both groups and each
+// panel draws its own part; the clearance widens that overlap inwards for a seam
+// that really sits a little further in than the line does.
+
+#include "main_window.h"
+#include "main_window_internal.h"
+
+#include "editor_state.h"
+#include "project_canvas.h"
+
+#include <QAction>
+#include <QDialog>
+#include <QDialogButtonBox>
+#include <QDoubleSpinBox>
+#include <QFormLayout>
+#include <QLabel>
+#include <QPushButton>
+#include <QStatusBar>
+#include <QVBoxLayout>
+
+namespace gui {
+
+namespace {
+
+constexpr double kSplitAngleMax = 180.0;
+constexpr double kSplitOffsetLimit = 100000.0;
+constexpr double kSplitMarginLimit = 10000.0;
+
+QString splitGroupName(const EditorState *state, const QString &base,
+                       const QString &suffix) {
+    QSet<QString> taken;
+    if (state != nullptr && state->sceneRoot() != nullptr) {
+        const auto walk = [&](auto &self, const fls::scene::Layer &node) -> void {
+            taken.insert(node.name);
+            if (node.kind() != fls::scene::LayerKind::Group) {
+                return;
+            }
+            for (const auto &child : static_cast<const fls::scene::Group &>(node).children) {
+                self(self, *child);
+            }
+        };
+        walk(walk, *state->sceneRoot());
+    }
+    QString name = QStringLiteral("%1 %2").arg(base, suffix);
+    for (int i = 2; taken.contains(name); ++i) {
+        name = QStringLiteral("%1 %2 %3").arg(base, suffix).arg(i);
+    }
+
+    return name;
+}
+
+} // namespace
+
+void MainWindow::setupSplitPanel() {
+    splitDialog_ = new QDialog(this);
+    splitDialog_->setWindowTitle(QStringLiteral("Split at a Line"));
+    splitDialog_->setWindowFlag(Qt::Tool);
+    splitDialog_->setModal(false);
+
+    auto *layout = new QVBoxLayout(splitDialog_);
+    auto *lead = new QLabel(
+        QStringLiteral("Drag the line on the canvas to move it, or drag an end "
+                       "handle to turn it. A layer the line crosses goes into "
+                       "both groups - it is copied, because a game shape cannot "
+                       "be cut in half."),
+        splitDialog_);
+    lead->setWordWrap(true);
+    layout->addWidget(lead);
+
+    auto *form = new QFormLayout;
+    splitAngleSpin_ = new QDoubleSpinBox(splitDialog_);
+    splitAngleSpin_->setRange(0.0, kSplitAngleMax);
+    splitAngleSpin_->setDecimals(1);
+    splitAngleSpin_->setSuffix(QStringLiteral(" deg"));
+    splitAngleSpin_->setWrapping(true);
+    splitOffsetSpin_ = new QDoubleSpinBox(splitDialog_);
+    splitOffsetSpin_->setRange(-kSplitOffsetLimit, kSplitOffsetLimit);
+    splitOffsetSpin_->setDecimals(1);
+    splitMarginSpin_ = new QDoubleSpinBox(splitDialog_);
+    splitMarginSpin_->setRange(0.0, kSplitMarginLimit);
+    splitMarginSpin_->setDecimals(1);
+    splitMarginSpin_->setToolTip(QStringLiteral(
+        "How far past the line each side may still reach. A layer touching this "
+        "band goes into both groups, so a seam that sits a little further in "
+        "than the line still has no bare strip."));
+    form->addRow(QStringLiteral("Angle"), splitAngleSpin_);
+    form->addRow(QStringLiteral("Line position"), splitOffsetSpin_);
+    form->addRow(QStringLiteral("Clearance"), splitMarginSpin_);
+    layout->addLayout(form);
+
+    splitTallyLabel_ = new QLabel(splitDialog_);
+    splitTallyLabel_->setWordWrap(true);
+    layout->addWidget(splitTallyLabel_);
+
+    auto *buttons = new QDialogButtonBox(splitDialog_);
+    splitApplyButton_ = buttons->addButton(QStringLiteral("Split"),
+                                           QDialogButtonBox::AcceptRole);
+    buttons->addButton(QDialogButtonBox::Close);
+    layout->addWidget(buttons);
+
+    const auto onValue = [this]() {
+        if (canvas_ == nullptr || splitUpdating_) {
+            return;
+        }
+        SplitLine line = canvas_->splitLine();
+        line.angleDeg = splitAngleSpin_->value();
+        line.offset = splitOffsetSpin_->value();
+        line.margin = splitMarginSpin_->value();
+        canvas_->setSplitLine(line);
+        refreshSplitTally();
+    };
+    connect(splitAngleSpin_, &QDoubleSpinBox::valueChanged, this, onValue);
+    connect(splitOffsetSpin_, &QDoubleSpinBox::valueChanged, this, onValue);
+    connect(splitMarginSpin_, &QDoubleSpinBox::valueChanged, this, onValue);
+    connect(buttons, &QDialogButtonBox::accepted, this, &MainWindow::applySplit);
+    connect(buttons, &QDialogButtonBox::rejected, splitDialog_, &QDialog::reject);
+    connect(splitDialog_, &QDialog::finished, this, [this](int) { closeSplitPanel(); });
+
+    if (canvas_ != nullptr) {
+        canvas_->setSplitLineChangedCallback([this]() {
+            splitUpdating_ = true;
+            const SplitLine line = canvas_->splitLine();
+            splitAngleSpin_->setValue(line.angleDeg);
+            splitOffsetSpin_->setValue(line.offset);
+            splitUpdating_ = false;
+            refreshSplitTally();
+        });
+    }
+}
+
+void MainWindow::openSplitPanel() {
+    if (state_ == nullptr || !state_->hasProject() || canvas_ == nullptr) {
+        return;
+    }
+    if (splitDialog_ == nullptr) {
+        setupSplitPanel();
+    }
+    splitEntries_ = state_->normalizeEntrySelection(selectedEntryIds());
+    QSet<QString> targets;
+    for (const QString &entryId : splitEntries_) {
+        for (const QString &leafId : state_->leafLayerIdsForEntry(entryId)) {
+            targets.insert(leafId);
+        }
+    }
+    if (targets.size() < 2) {
+        statusBar()->showMessage(
+            QStringLiteral("Select two or more layers before splitting - "
+                           "selecting a group takes every layer in it."),
+            4000);
+        return;
+    }
+    canvas_->setSplitTargets(targets);
+    const QRectF bounds = canvas_->splitTargetsWorldBounds();
+    SplitLine line;
+    line.angleDeg = 0.0;
+    line.margin = 0.0;
+    const QPointF centre = bounds.isNull() ? QPointF(0.0, 0.0) : bounds.center();
+    line.offset = line.normal().x() * centre.x() + line.normal().y() * centre.y();
+    canvas_->setSplitLine(line);
+    canvas_->setSplitLineActive(true);
+    canvas_->setTool(QStringLiteral("split"));
+
+    splitUpdating_ = true;
+    splitAngleSpin_->setValue(line.angleDeg);
+    splitOffsetSpin_->setValue(line.offset);
+    splitMarginSpin_->setValue(line.margin);
+    splitUpdating_ = false;
+    refreshSplitTally();
+    splitDialog_->show();
+    splitDialog_->raise();
+}
+
+void MainWindow::closeSplitPanel() {
+    if (canvas_ != nullptr) {
+        canvas_->setSplitLineActive(false);
+        canvas_->setSplitTargets({});
+        if (canvas_->tool() == QStringLiteral("split")) {
+            canvas_->setTool(QStringLiteral("select"));
+        }
+    }
+    splitEntries_.clear();
+    if (splitDialog_ != nullptr && splitDialog_->isVisible()) {
+        splitDialog_->hide();
+    }
+}
+
+void MainWindow::refreshSplitTally() {
+    if (splitTallyLabel_ == nullptr || canvas_ == nullptr) {
+        return;
+    }
+    QSet<QString> sideA;
+    QSet<QString> sideB;
+    canvas_->classifySplitTargets(canvas_->splitLine(), &sideA, &sideB);
+    const QSet<QString> both = sideA & sideB;
+    splitTallyLabel_->setText(QStringLiteral(
+        "Side A %1  ·  Side B %2  ·  both %3 (copied)")
+        .arg(sideA.size()).arg(sideB.size()).arg(both.size()));
+    const bool usable = !sideA.isEmpty() && !sideB.isEmpty();
+    if (splitApplyButton_ != nullptr) {
+        splitApplyButton_->setEnabled(usable);
+    }
+    if (!usable) {
+        splitTallyLabel_->setText(splitTallyLabel_->text()
+            + QStringLiteral("\nOne side is empty - move the line into the artwork."));
+    }
+}
+
+void MainWindow::applySplit() {
+    if (state_ == nullptr || canvas_ == nullptr || splitEntries_.isEmpty()) {
+        return;
+    }
+    QSet<QString> sideA;
+    QSet<QString> sideB;
+    canvas_->classifySplitTargets(canvas_->splitLine(), &sideA, &sideB);
+    const QString base = QStringLiteral("Split");
+    const QString nameA = splitGroupName(state_, base, QStringLiteral("A"));
+    const QString nameB = splitGroupName(state_, base, QStringLiteral("B"));
+
+    state_->beginProjectEdit();
+    const SplitOutcome outcome =
+        state_->splitEntriesAtLine(splitEntries_, sideA, sideB, nameA, nameB);
+    if (!outcome.ok) {
+        state_->cancelProjectEdit();
+        statusBar()->showMessage(outcome.error, 5000);
+        return;
+    }
+    state_->commitProjectEdit();
+    state_->noteProjectStructureChanged();
+    closeSplitPanel();
+    statusBar()->showMessage(
+        QStringLiteral("Split into %1 (%2 layers) and %3 (%4 layers)%5")
+            .arg(nameA).arg(outcome.sideA).arg(nameB).arg(outcome.sideB)
+            .arg(outcome.copied > 0
+                     ? QStringLiteral(" - %1 layer(s) the line crossed went into both")
+                           .arg(outcome.copied)
+                     : QString()),
+        8000);
+}
+
+} // namespace gui

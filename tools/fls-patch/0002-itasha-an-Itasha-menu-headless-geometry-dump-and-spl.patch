+// Headless panel-geometry dump: takes a car (a .carbin, a model, or the game's
+// car .zip) and writes the file the Itasha engine reads. Everything it needs -
+// the meshes, the paint masks - is plain data, so no window and no GL context
+// are involved and it can run from a script.
+int runItashaDump(const QString &carPath, const QString &outPath) {
+    QTextStream err(stderr);
+    QString loadPath = carPath;
+    QTemporaryDir extracted;
+    if (carPath.endsWith(QStringLiteral(".zip"), Qt::CaseInsensitive)) {
+        QString zipError;
+        if (!extracted.isValid()
+            || !fls::extractZipArchive(carPath, extracted.path(), &zipError)) {
+            err << "itasha-dump: " << zipError << Qt::endl;
+            return 1;
+        }
+        QDirIterator it(extracted.path(), QStringList{QStringLiteral("*.carbin")},
+                        QDir::Files, QDirIterator::Subdirectories);
+        loadPath = it.hasNext() ? it.next() : QString();
+        if (loadPath.isEmpty()) {
+            err << "itasha-dump: no .carbin inside " << carPath << Qt::endl;
+            return 1;
+        }
+    }
+    QString error;
+    const fls::CarModel model =
+        loadPath.endsWith(QStringLiteral(".carbin"), Qt::CaseInsensitive)
+        ? fls::loadCarBin(loadPath, &error)
+        : fls::loadModelBin(loadPath, &error);
+    if (model.meshes.empty()) {
+        err << "itasha-dump: " << (error.isEmpty()
+                                       ? QStringLiteral("car model has no meshes")
+                                       : error) << Qt::endl;
+        return 1;
+    }
+    const QString masksDir =
+        QFileInfo(loadPath).absoluteDir().filePath(QStringLiteral("LiveryMasks"));
+    const fls::LiveryMaskSet masks = fls::loadLiveryMasks(masksDir, &error);
+    if (!masks.valid()) {
+        err << "itasha-dump: " << (error.isEmpty()
+                                       ? QStringLiteral("no LiveryMasks next to the car")
+                                       : error) << Qt::endl;
+        return 1;
+    }
+    if (!gui::dumpItashaGeometry(model, masks, outPath, &error)) {
+        err << "itasha-dump: " << error << Qt::endl;
+        return 1;
+    }
+    QTextStream(stdout) << outPath << Qt::endl;
+    return 0;
+}

+// Itasha menu: composing a livery out of character artwork, and handing a
+// vinyl group to the tools that speak the other formats.
+//
+// The heavy work - reading the car's paint masks, placing a design on a panel,
+// carrying the part that runs off an edge onto the neighbouring panel, growing
+// the decoration, mirroring left to right, choosing the base paint, checking
+// the per-panel decal budget - is done by an external engine (ForzaSqueegee).
+// It reads and rewrites the project document, so an entry here is always the
+// same three steps: hand it the saved project, run it, reload what it wrote.
+//
+// Two families of entries, and which one is live depends on the open project:
+//
+//   livery  place a design, auto-place, join across seams, decoration, motif,
+//           mirror, base paint, export the game container
+//   group   export this vinyl group as a game container, as KFPS JSON, or as
+//           a ForzaSqueegee plan.json
+//
+// The engine is not required to run the editor. Its command is read from
+// QSettings ("itasha/command", a string list, plus "itasha/cwd"); when it is
+// absent the menu says so and stays disabled.
+
+#include "main_window.h"
+#include "main_window_internal.h"
+
+#include "car_preview_widget.h"
+#include "editor_state.h"
+#include "import_locations.h"
+
+#include <QAction>
+#include <QApplication>
+#include <QColor>
+#include <QColorDialog>
+#include <QDir>
+#include <QFileDialog>
+#include <QGuiApplication>
+#include <QMenu>
+#include <QMenuBar>
+#include <QMessageBox>
+#include <QProcess>
+#include <QSettings>
+#include <QStandardPaths>
+#include <QStatusBar>
+#include <QStringList>
+#include <QTemporaryDir>
+
+namespace gui {
+
+namespace {
+
+constexpr auto kItashaCommandKey = "itasha/command";
+constexpr auto kItashaCwdKey = "itasha/cwd";
+constexpr int kItashaTimeoutMs = 30 * 60 * 1000;   // 도안 하나가 몇 분 걸린다
+
+// Motif families the engine knows (engine/compose/vocabulary.py). The design's
+// theme colour picks one on its own, which is what "Auto" leaves it doing.
+const char *const kMotifFamilies[] = {"star", "flower", "splat", "swirl",
+                                      "crystal"};
+
+// Exporting a vinyl group: the same design, in the three formats the tools
+// share.
+struct GroupFormat {
+    const char *text;
+    const char *format;
+    const char *tip;
+};
+
+const GroupFormat kGroupFormats[] = {
+    {"&Game Container (C_group)...", "fls",
+     "LayerGroup_<name>/C_group + header - drop it in the game's save container "
+     "and it shows up in the grid"},
+    {"&KFPS JSON...", "kfps",
+     "The typecode JSON the KFPS editor and its tools read"},
+    {"ForzaSqueegee &plan.json...", "plan",
+     "The design format every ForzaSqueegee command takes"},
+};
+
+// The Itasha groups the selection sits in. The engine names each chunk it
+// builds "FS:<name>" (a design is FS:decal-1-fit), so walking up from whatever
+// is selected to the nearest such group says which artwork the person means -
+// which is what an entry like Auto-place on This Section acts on. Returns the
+// names without the prefix; empty when the selection is not inside one.
+QStringList selectedItashaGroups(const EditorState *state) {
+    QStringList out;
+    if (state == nullptr) {
+        return out;
+    }
+    QVector<QString> ids;
+    for (const QString &id : state->selectedLayerIds()) {
+        ids.push_back(id);
+    }
+    ids += state->fullySelectedTopGroupIds();
+    for (const QString &id : ids) {
+        for (const fls::scene::Layer *node = state->sceneNode(id);
+             node != nullptr; node = node->parent()) {
+            if (node->kind() != fls::scene::LayerKind::Group
+                || !node->name.startsWith(QStringLiteral("FS:"))) {
+                continue;
+            }
+            const QString name = node->name.mid(3);
+            if (!out.contains(name)) {
+                out.push_back(name);
+            }
+            break;
+        }
+    }
+
+    return out;
+}
+
+QString itashaWorkDir() {
+    const QString base = QStandardPaths::writableLocation(
+        QStandardPaths::AppLocalDataLocation);
+    QDir().mkpath(base + QStringLiteral("/itasha"));
+
+    return base + QStringLiteral("/itasha");
+}
+
+} // namespace
+
+QStringList MainWindow::itashaCommand() const {
+    QSettings settings;
+    const QStringList command =
+        settings.value(QLatin1String(kItashaCommandKey)).toStringList();
+    if (command.isEmpty() || command.first().trimmed().isEmpty()) {
+        return {};
+    }
+
+    return command;
+}
+
+void MainWindow::setupItashaMenu() {
+    itashaMenu_ = menuBar()->addMenu(QStringLiteral("&Itasha"));
+    itashaLiveryActions_.clear();
+    itashaGroupActions_.clear();
+
+    // Which entries are live depends on the open project, so the menu has to
+    // hear about a project arriving. Without this it is built before any
+    // project exists and stays greyed out until an entry runs - which none can,
+    // because they are greyed out.
+    if (state_ != nullptr) {
+        connect(state_, &EditorState::projectReset,
+                this, &MainWindow::refreshItashaMenu);
+        connect(state_, &EditorState::projectStructureChanged,
+                this, &MainWindow::refreshItashaMenu);
+    }
+
+    const auto addLiveryEntry = [this](QMenu *menu, const QString &text,
+                                       const QString &action, const QString &tip,
+                                       const QStringList &extra = {}) {
+        QAction *entry = menu->addAction(text);
+        entry->setStatusTip(tip);
+        connect(entry, &QAction::triggered, this,
+                [this, action, extra]() { runItashaAction(action, extra); });
+        itashaLiveryActions_.push_back(entry);
+
+        return entry;
+    };
+
+    QAction *load = itashaMenu_->addAction(
+        QStringLiteral("&Load Design into Section..."));
+    load->setStatusTip(QStringLiteral(
+        "Place a design on the active livery panel - a ForzaSqueegee plan.json, "
+        "a KFPS JSON, or a vinyl group (.3so / C_group)"));
+    connect(load, &QAction::triggered, this, [this]() {
+        const QString path = QFileDialog::getOpenFileName(
+            this, QStringLiteral("Load Design into Section"),
+            importDialogStartDirectory(this, QStringLiteral("itashaDesign")),
+            QStringLiteral("Any design (plan.json *.json *.3so C_group);;"
+                           "ForzaSqueegee design (plan.json);;"
+                           "KFPS JSON (*.json);;"
+                           "Vinyl group (*.3so C_group);;"
+                           "All files (*)"));
+        if (path.isEmpty()) {
+            return;
+        }
+        rememberImportDirectory(path, QStringLiteral("itashaDesign"));
+        runItashaAction(QStringLiteral("load-design"),
+                        {QStringLiteral("--design"), path});
+    });
+    itashaLiveryActions_.push_back(load);
+
+    addLiveryEntry(itashaMenu_, QStringLiteral("&Auto-place on This Section"),
+                   QStringLiteral("auto-place"),
+                   QStringLiteral("Move the panel's artwork to the place the "
+                                  "reference liveries put it"));
+    itashaMenu_->addSeparator();
+    // Nothing here carries artwork across a seam. A design that runs off its
+    // panel is cut there, the way the game draws it; to carry it onto the
+    // neighbour, split it at the seam (Edit > Split Selection at a Line) and
+    // move one of the two groups.
+    //
+    // Decoration is off until it is asked for. Loading a design puts the
+    // artwork on the car and nothing else; bands, motifs and the roof blackout
+    // grow only when someone picks this entry, and stay on from then until
+    // Drop Decoration.
+    addLiveryEntry(itashaMenu_,
+                   QStringLiteral("Grow &Decoration (bands, motifs, roof)"),
+                   QStringLiteral("decoration"),
+                   QStringLiteral("Grow the bands, scattered motifs and roof "
+                                  "blackout around the artwork. Off until you "
+                                  "ask for it."));
+    addLiveryEntry(itashaMenu_, QStringLiteral("Drop Decoration (artwork &only)"),
+                   QStringLiteral("no-decoration"),
+                   QStringLiteral("Leave only the artwork - no bands, motifs or "
+                                  "roof blackout. The base paint stays."));
+
+    QMenu *motif = itashaMenu_->addMenu(QStringLiteral("&Motif Family"));
+    motif->setStatusTip(QStringLiteral(
+        "Which family the scattered decoration draws from. The design's theme "
+        "colour picks one; a character you know is better picked by hand. "
+        "Picking a family does not switch the decoration on."));
+    addLiveryEntry(motif, QStringLiteral("&Auto (the design picks)"),
+                   QStringLiteral("motif"),
+                   QStringLiteral("Let the design's theme colour choose"));
+    for (const char *family : kMotifFamilies) {
+        const QString name = QString::fromLatin1(family);
+        addLiveryEntry(motif, name.at(0).toUpper() + name.mid(1),
+                       QStringLiteral("motif"),
+                       QStringLiteral("Use the %1 family").arg(name),
+                       {QStringLiteral("--family"), name});
+    }
+
+    itashaMenu_->addSeparator();
+    addLiveryEntry(itashaMenu_, QStringLiteral("Mirror Left/&Right"),
+                   QStringLiteral("mirror"),
+                   QStringLiteral("Copy the side and door-glass panels onto "
+                                  "their mirrored counterparts"));
+
+    QMenu *paint = itashaMenu_->addMenu(QStringLiteral("&Base Paint"));
+    paint->setStatusTip(QStringLiteral(
+        "The single colour the whole car is painted. It is paint, not vinyl - "
+        "it costs no layers and carries a gloss no decal can."));
+    addLiveryEntry(paint, QStringLiteral("&From the Design"),
+                   QStringLiteral("base-paint"),
+                   QStringLiteral("Choose the colour from the artwork"));
+    QAction *pick = paint->addAction(QStringLiteral("&Pick Colour..."));
+    pick->setStatusTip(QStringLiteral("Paint the car a colour you choose"));
+    connect(pick, &QAction::triggered, this, [this]() {
+        const QColor chosen = QColorDialog::getColor(
+            Qt::white, this, QStringLiteral("Base Paint"));
+        if (!chosen.isValid()) {
+            return;
+        }
+        runItashaAction(QStringLiteral("base-paint"),
+                        {QStringLiteral("--color"), chosen.name(QColor::HexRgb)});
+    });
+    itashaLiveryActions_.push_back(pick);
+
+    itashaMenu_->addSeparator();
+    QAction *exportLivery = itashaMenu_->addAction(
+        QStringLiteral("&Export to Game Container..."));
+    exportLivery->setStatusTip(QStringLiteral(
+        "Write the Livery_<name>/C_livery + header the game reads"));
+    connect(exportLivery, &QAction::triggered, this, [this]() {
+        const QString folder = QFileDialog::getExistingDirectory(
+            this, QStringLiteral("Export Livery Container"),
+            importDialogStartDirectory(this, QStringLiteral("itashaExport")));
+        if (folder.isEmpty()) {
+            return;
+        }
+        rememberImportDirectory(folder, QStringLiteral("itashaExport"));
+        runItashaAction(QStringLiteral("export"),
+                        {QStringLiteral("--out"), folder});
+    });
+    itashaLiveryActions_.push_back(exportLivery);
+
+    QMenu *group = itashaMenu_->addMenu(QStringLiteral("Export &Group As"));
+    group->setStatusTip(QStringLiteral(
+        "Write this vinyl group in one of the three formats the tools share"));
+    for (const GroupFormat &fmt : kGroupFormats) {
+        QAction *entry = group->addAction(QString::fromLatin1(fmt.text));
+        entry->setStatusTip(QString::fromLatin1(fmt.tip));
+        const QString format = QString::fromLatin1(fmt.format);
+        connect(entry, &QAction::triggered, this, [this, format]() {
+            const QString folder = QFileDialog::getExistingDirectory(
+                this, QStringLiteral("Export Group"),
+                importDialogStartDirectory(this, QStringLiteral("itashaGroup")));
+            if (folder.isEmpty()) {
+                return;
+            }
+            rememberImportDirectory(folder, QStringLiteral("itashaGroup"));
+            runItashaAction(QStringLiteral("export-group"),
+                            {QStringLiteral("--format"), format,
+                             QStringLiteral("--out"), folder},
+                            /*needLivery=*/false, /*reload=*/false);
+        });
+        itashaGroupActions_.push_back(entry);
+    }
+
+    itashaMenu_->addSeparator();
+    QAction *dump = itashaMenu_->addAction(QStringLiteral("Dump Car Geometr&y..."));
+    dump->setStatusTip(QStringLiteral(
+        "Write the loaded car's panel geometry for the Itasha engine"));
+    connect(dump, &QAction::triggered, this, [this]() {
+        if (carPreview_ == nullptr || !carPreview_->hasModel()) {
+            QMessageBox::information(
+                this, QStringLiteral("Itasha"),
+                QStringLiteral("Import a car model first - the panel geometry "
+                               "comes from it."));
+            return;
+        }
+        const QString path = QFileDialog::getSaveFileName(
+            this, QStringLiteral("Dump Car Geometry"),
+            QDir(itashaWorkDir()).filePath(
+                carPreview_->loadedCarMedia() + QStringLiteral(".fsgeom")),
+            QStringLiteral("Itasha geometry (*.fsgeom);;All files (*)"));
+        if (path.isEmpty()) {
+            return;
+        }
+        QString error;
+        if (!carPreview_->dumpItashaGeometry(path, &error)) {
+            QMessageBox::warning(this, QStringLiteral("Itasha"), error);
+            return;
+        }
+        statusBar()->showMessage(QStringLiteral("Wrote %1").arg(path), 5000);
+    });
+
+    refreshItashaMenu();
+}
+
+void MainWindow::refreshItashaMenu() {
+    if (itashaMenu_ == nullptr) {
+        return;
+    }
+    const bool haveEngine = !itashaCommand().isEmpty();
+    const bool open = state_ != nullptr && state_->hasProject();
+    const bool livery = open && state_->project_.isLivery;
+    for (QAction *entry : itashaLiveryActions_) {
+        entry->setEnabled(haveEngine && livery);
+    }
+    for (QAction *entry : itashaGroupActions_) {
+        entry->setEnabled(haveEngine && open && !livery);
+    }
+    itashaMenu_->setToolTipsVisible(true);
+    if (!haveEngine) {
+        itashaMenu_->setTitle(QStringLiteral("&Itasha (engine not configured)"));
+    } else if (!open) {
+        itashaMenu_->setTitle(QStringLiteral("&Itasha (open a project)"));
+    } else {
+        itashaMenu_->setTitle(QStringLiteral("&Itasha"));
+    }
+}
+
+bool MainWindow::runItashaAction(const QString &action, const QStringList &extra,
+                                 bool needLivery, bool reload) {
+    const QStringList command = itashaCommand();
+    if (command.isEmpty()) {
+        QMessageBox::information(
+            this, QStringLiteral("Itasha"),
+            QStringLiteral(
+                "No Itasha engine is configured.\n\nLaunch this editor from "
+                "ForzaSqueegee once and it registers itself, or set "
+                "itasha/command in the editor's settings."));
+        return false;
+    }
+    if (state_ == nullptr || !state_->hasProject()) {
+        QMessageBox::information(this, QStringLiteral("Itasha"),
+                                 QStringLiteral("Open a project first."));
+        return false;
+    }
+    if (needLivery != state_->project_.isLivery) {
+        QMessageBox::information(
+            this, QStringLiteral("Itasha"),
+            needLivery
+                ? QStringLiteral("Open a livery project first.")
+                : QStringLiteral("This entry exports a vinyl group, and the "
+                                 "open project is a livery."));
+        return false;
+    }
+
+    // The engine works on a saved project, so an unsaved one goes to the work
+    // folder first and stays there - reopening it later is the user's business.
+    QString projectPath = projectJsonPath_;
+    if (projectPath.isEmpty()) {
+        projectPath = QDir(itashaWorkDir()).filePath(
+            mw_detail::safeGroupName(state_->project_.name) + QStringLiteral(".3so"));
+    }
+    QString error;
+    if (!saveProjectJson(projectPath, &error)) {
+        QMessageBox::critical(this, QStringLiteral("Itasha"), error);
+        return false;
+    }
+    projectJsonPath_ = projectPath;
+
+    // Panel geometry: the engine needs to know where the car's surface is to
+    // carry artwork across a seam, and the dump's file name tells it which car
+    // this is. Write it next to the project, once per car.
+    QStringList arguments = command.mid(1);
+    arguments << action << QStringLiteral("--project") << projectPath;
+    if (carPreview_ != nullptr && carPreview_->hasModel()) {
+        const QString geometry = QDir(itashaWorkDir()).filePath(
+            carPreview_->loadedCarMedia() + QStringLiteral(".fsgeom"));
+        QString dumpError;
+        if (carPreview_->dumpItashaGeometry(geometry, &dumpError)) {
+            arguments << QStringLiteral("--geometry") << geometry;
+        } else {
+            statusBar()->showMessage(
+                QStringLiteral("Itasha: %1").arg(dumpError), 5000);
+        }
+    }
+    const int slot = activeLiverySectionSlot();
+    if (slot >= 0) {
+        arguments << QStringLiteral("--slot") << QString::number(slot);
+    }
+    const QStringList groups = selectedItashaGroups(state_);
+    if (!groups.isEmpty()) {
+        arguments << QStringLiteral("--group") << groups;
+    }
+    arguments << extra;
+
+    QSettings settings;
+    const QString cwd = settings.value(QLatin1String(kItashaCwdKey)).toString();
+    statusBar()->showMessage(QStringLiteral("Itasha: %1...").arg(action));
+    QGuiApplication::setOverrideCursor(Qt::WaitCursor);
+    QProcess process;
+    if (!cwd.isEmpty()) {
+        process.setWorkingDirectory(cwd);
+    }
+    process.start(command.first(), arguments);
+    const bool finished = process.waitForFinished(kItashaTimeoutMs);
+    QGuiApplication::restoreOverrideCursor();
+    // The engine writes UTF-8 whatever the console code page is (it
+    // reconfigures its own streams), so decode it as UTF-8 - fromLocal8Bit
+    // turns its Korean into mojibake on a cp949 machine.
+    const QString output = QString::fromUtf8(process.readAllStandardOutput())
+        + QString::fromUtf8(process.readAllStandardError());
+    if (!finished || process.exitStatus() != QProcess::NormalExit
+        || process.exitCode() != 0) {
+        QMessageBox box(this);
+        box.setIcon(QMessageBox::Warning);
+        box.setWindowTitle(QStringLiteral("Itasha"));
+        box.setText(QStringLiteral("The Itasha engine reported a problem."));
+        box.setDetailedText(output.isEmpty()
+                                ? QStringLiteral("no output")
+                                : output);
+        box.exec();
+        return false;
+    }
+
+    if (reload && !loadProjectJson(projectPath, &error)) {
+        QMessageBox::critical(this, QStringLiteral("Itasha"), error);
+        return false;
+    }
+    // The engine prints one summary line; show its last line, which is the one
+    // written for a human.
+    const QStringList lines = output.split(QLatin1Char('\n'), Qt::SkipEmptyParts);
+    statusBar()->showMessage(
+        lines.isEmpty() ? QStringLiteral("Itasha: %1 done").arg(action)
+                        : lines.last().trimmed(),
+        8000);
+    refreshItashaMenu();
+
+    return true;
+}
+
+} // namespace gui

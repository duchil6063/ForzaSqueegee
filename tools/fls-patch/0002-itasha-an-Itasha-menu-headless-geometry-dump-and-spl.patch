diff --git a/src/gui/canvas/project_canvas_split.cpp b/src/gui/canvas/project_canvas_split.cpp
new file mode 100644
index 0000000..7c76c28
--- /dev/null
+++ b/src/gui/canvas/project_canvas_split.cpp
@@ -0,0 +1,320 @@
+// Splitting a design at a line: the line itself, dragging it, and deciding
+// which side each selected shape reaches.
+//
+// The canvas owns this because it is the only place that knows where a shape
+// actually sits in section units - a shape's world quad is its local rect
+// carried through every group frame above it. The window owns the numbers
+// beside the line and runs the split on EditorState.
+
+#include "project_canvas.h"
+#include "project_canvas_internal.h"
+
+#include "canvas_tools.h"
+#include "editor_state.h"
+
+#include <QMouseEvent>
+#include <QPainter>
+
+#include <algorithm>
+#include <cmath>
+
+namespace gui {
+
+namespace {
+
+constexpr double kSplitHandleScreenGap = 130.0;
+constexpr double kSplitLabelScreenGap = 42.0;
+constexpr double kSplitGrabScreenRadius = 12.0;
+constexpr double kSplitHandleScreenRadius = 6.0;
+constexpr double kSplitScreenReach = 8000.0;
+
+const QColor kSplitLineColor(255, 47, 146);
+const QColor kSplitBandColor(255, 138, 198);
+
+} // namespace
+
+void ProjectCanvas::setSplitLineActive(bool active) {
+    if (splitLineActive_ == active) {
+        return;
+    }
+    splitLineActive_ = active;
+    splitDragMode_ = 0;
+    update();
+}
+
+bool ProjectCanvas::splitLineActive() const {
+    return splitLineActive_;
+}
+
+void ProjectCanvas::setSplitLine(const SplitLine &line) {
+    splitLine_ = line;
+    splitLine_.margin = std::max(0.0, splitLine_.margin);
+    update();
+}
+
+SplitLine ProjectCanvas::splitLine() const {
+    return splitLine_;
+}
+
+void ProjectCanvas::setSplitLineChangedCallback(std::function<void()> callback) {
+    splitLineChangedCallback_ = std::move(callback);
+}
+
+void ProjectCanvas::setSplitTargets(const QSet<QString> &layerIds) {
+    splitTargets_ = layerIds;
+    update();
+}
+
+QRectF ProjectCanvas::splitTargetsWorldBounds() const {
+    QRectF bounds;
+    forEachSceneShape([&](const fls::scene::Shape &shape, const QTransform &world, int) {
+        if (!splitTargets_.contains(shape.id)) {
+            return true;
+        }
+        const QRectF local = sceneLocalRect(shape, geometry_);
+        QPolygonF quad;
+        quad << world.map(local.topLeft()) << world.map(local.topRight())
+             << world.map(local.bottomRight()) << world.map(local.bottomLeft());
+        bounds = bounds.isNull() ? quad.boundingRect()
+                                 : bounds.united(quad.boundingRect());
+        return true;
+    }, false);
+
+    return bounds;
+}
+
+void ProjectCanvas::classifySplitTargets(const SplitLine &line,
+                                         QSet<QString> *sideA,
+                                         QSet<QString> *sideB) const {
+    if (sideA != nullptr) {
+        sideA->clear();
+    }
+    if (sideB != nullptr) {
+        sideB->clear();
+    }
+    const double margin = std::max(0.0, line.margin);
+    forEachSceneShape([&](const fls::scene::Shape &shape, const QTransform &world, int) {
+        if (!splitTargets_.contains(shape.id)) {
+            return true;
+        }
+        const QRectF local = sceneLocalRect(shape, geometry_);
+        const QPointF corners[4] = {
+            world.map(local.topLeft()), world.map(local.topRight()),
+            world.map(local.bottomRight()), world.map(local.bottomLeft()),
+        };
+        double lowest = std::numeric_limits<double>::max();
+        double highest = std::numeric_limits<double>::lowest();
+        for (const QPointF &corner : corners) {
+            const double d = line.signedDistance(corner);
+            lowest = std::min(lowest, d);
+            highest = std::max(highest, d);
+        }
+        // Reaching into a side at all puts the shape there. A shape the band
+        // touches reaches into both, and the split copies it.
+        if (sideA != nullptr && lowest <= margin) {
+            sideA->insert(shape.id);
+        }
+        if (sideB != nullptr && highest >= -margin) {
+            sideB->insert(shape.id);
+        }
+        return true;
+    }, false);
+}
+
+// ────────────────────────── dragging ──────────────────────────
+
+QPointF ProjectCanvas::splitAnchorPoint() const {
+    const QRectF bounds = splitTargetsWorldBounds();
+    const QPointF nearby = bounds.isNull() ? QPointF(0.0, 0.0) : bounds.center();
+
+    return splitLine_.anchor(nearby);
+}
+
+bool ProjectCanvas::beginSplitDrag(const QPointF &screenPoint) {
+    if (!splitLineActive_) {
+        return false;
+    }
+    const QPointF world = screenToWorld(screenPoint);
+    const QPointF anchorScreen = worldToScreen(splitAnchorPoint());
+    const QPointF direction = splitLine_.direction();
+    const QPointF alongScreen =
+        worldToScreen(splitAnchorPoint() + direction) - anchorScreen;
+    const double alongLength = std::hypot(alongScreen.x(), alongScreen.y());
+    if (alongLength > 1e-9) {
+        const QPointF unit = alongScreen / alongLength;
+        for (const double sign : {-1.0, 1.0}) {
+            const QPointF handle = anchorScreen + unit * (sign * kSplitHandleScreenGap);
+            if (QLineF(handle, screenPoint).length()
+                <= kSplitGrabScreenRadius + kSplitHandleScreenRadius) {
+                splitDragMode_ = 2;
+                splitDragSign_ = sign;
+                splitAnchorWorld_ = splitAnchorPoint();
+                return true;
+            }
+        }
+    }
+    // Distance to the line, measured on screen so the grab feels the same at
+    // every zoom.
+    const QPointF onLine = splitLine_.anchor(world);
+    if (QLineF(worldToScreen(onLine), screenPoint).length() <= kSplitGrabScreenRadius) {
+        splitDragMode_ = 1;
+        splitDragGrab_ = splitLine_.signedDistance(world);
+        return true;
+    }
+
+    return false;
+}
+
+bool ProjectCanvas::updateSplitDrag(const QPointF &screenPoint) {
+    if (splitDragMode_ == 0) {
+        return false;
+    }
+    const QPointF world = screenToWorld(screenPoint);
+    if (splitDragMode_ == 1) {
+        const QPointF n = splitLine_.normal();
+        splitLine_.offset = n.x() * world.x() + n.y() * world.y() - splitDragGrab_;
+    } else {
+        // Turning pivots on the anchor, so the line keeps passing through the
+        // place it was put.
+        const QPointF v = (world - splitAnchorWorld_) * splitDragSign_;
+        if (std::hypot(v.x(), v.y()) < 1e-9) {
+            return true;
+        }
+        double degrees = qRadiansToDegrees(std::atan2(v.y(), v.x()));
+        degrees = std::fmod(std::fmod(degrees, 180.0) + 180.0, 180.0);
+        splitLine_.angleDeg = degrees;
+        const QPointF n = splitLine_.normal();
+        splitLine_.offset =
+            n.x() * splitAnchorWorld_.x() + n.y() * splitAnchorWorld_.y();
+    }
+    if (splitLineChangedCallback_) {
+        splitLineChangedCallback_();
+    }
+    update();
+
+    return true;
+}
+
+void ProjectCanvas::endSplitDrag() {
+    splitDragMode_ = 0;
+}
+
+bool ProjectCanvas::splitLineNearScreenPoint(const QPointF &screenPoint) const {
+    if (!splitLineActive_) {
+        return false;
+    }
+    const QPointF world = screenToWorld(screenPoint);
+    const QPointF onLine = splitLine_.anchor(world);
+    if (QLineF(worldToScreen(onLine), screenPoint).length() <= kSplitGrabScreenRadius) {
+        return true;
+    }
+    const QPointF anchorScreen = worldToScreen(splitAnchorPoint());
+    const QPointF alongScreen =
+        worldToScreen(splitAnchorPoint() + splitLine_.direction()) - anchorScreen;
+    const double alongLength = std::hypot(alongScreen.x(), alongScreen.y());
+    if (alongLength <= 1e-9) {
+        return false;
+    }
+    const QPointF unit = alongScreen / alongLength;
+    for (const double sign : {-1.0, 1.0}) {
+        const QPointF handle = anchorScreen + unit * (sign * kSplitHandleScreenGap);
+        if (QLineF(handle, screenPoint).length()
+            <= kSplitGrabScreenRadius + kSplitHandleScreenRadius) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+// ────────────────────────── painting ──────────────────────────
+
+void ProjectCanvas::drawSplitLine(QPainter &painter) {
+    if (!splitLineActive_) {
+        return;
+    }
+    const QPointF anchorScreen = worldToScreen(splitAnchorPoint());
+    const QPointF along = worldToScreen(splitAnchorPoint() + splitLine_.direction())
+        - anchorScreen;
+    const QPointF across = worldToScreen(splitAnchorPoint() + splitLine_.normal())
+        - anchorScreen;
+    const double alongLength = std::hypot(along.x(), along.y());
+    const double acrossLength = std::hypot(across.x(), across.y());
+    if (alongLength <= 1e-9 || acrossLength <= 1e-9) {
+        return;
+    }
+    const QPointF alongUnit = along / alongLength;
+    const QPointF acrossUnit = across / acrossLength;
+    const QPointF reach = alongUnit * kSplitScreenReach;
+    const double bandScreen = splitLine_.margin * acrossLength;
+
+    painter.save();
+    if (bandScreen > 0.5) {
+        QPen bandPen(kSplitBandColor, 1.0, Qt::DashLine);
+        painter.setPen(bandPen);
+        for (const double sign : {-1.0, 1.0}) {
+            const QPointF centre = anchorScreen + acrossUnit * (sign * bandScreen);
+            painter.drawLine(centre - reach, centre + reach);
+        }
+    }
+    painter.setPen(QPen(kSplitLineColor, 2.0));
+    painter.drawLine(anchorScreen - reach, anchorScreen + reach);
+
+    painter.setBrush(Qt::white);
+    for (const double sign : {-1.0, 1.0}) {
+        const QPointF handle = anchorScreen + alongUnit * (sign * kSplitHandleScreenGap);
+        painter.drawEllipse(handle, kSplitHandleScreenRadius, kSplitHandleScreenRadius);
+    }
+    // A and B, so which group is which never depends on reading the angle.
+    QFont labelFont = painter.font();
+    labelFont.setBold(true);
+    labelFont.setPointSizeF(std::max(10.0, labelFont.pointSizeF() * 1.4));
+    painter.setFont(labelFont);
+    painter.setPen(kSplitLineColor);
+    painter.setBrush(Qt::NoBrush);
+    const QFontMetricsF metrics(labelFont);
+    const QString labels[2] = {QStringLiteral("A"), QStringLiteral("B")};
+    const double signs[2] = {-1.0, 1.0};
+    for (int i = 0; i < 2; ++i) {
+        const QPointF at = anchorScreen
+            + acrossUnit * (signs[i] * (kSplitLabelScreenGap + bandScreen));
+        const QRectF box(at.x() - 12.0, at.y() - metrics.height() * 0.5,
+                         24.0, metrics.height());
+        painter.drawText(box, Qt::AlignCenter, labels[i]);
+    }
+    painter.restore();
+}
+
+// ────────────────────────── the tool ──────────────────────────
+
+QString SplitTool::name() const {
+    return QStringLiteral("split");
+}
+
+bool SplitTool::handlePress(QMouseEvent *event) {
+    if (event->button() != Qt::LeftButton) {
+        return false;
+    }
+    return canvas_.beginSplitDrag(event->position());
+}
+
+bool SplitTool::handleMove(QMouseEvent *event) {
+    return canvas_.updateSplitDrag(event->position());
+}
+
+bool SplitTool::handleRelease(QMouseEvent *event) {
+    Q_UNUSED(event);
+    if (canvas_.splitDragMode_ == 0) {
+        return false;
+    }
+    canvas_.endSplitDrag();
+
+    return true;
+}
+
+Qt::CursorShape SplitTool::idleCursorShape(const QPointF &point) const {
+    return canvas_.splitLineNearScreenPoint(point) ? Qt::SizeAllCursor
+                                                   : Qt::ArrowCursor;
+}
+
+} // namespace gui
diff --git a/src/gui/canvas/split_line.h b/src/gui/canvas/split_line.h
new file mode 100644
index 0000000..6eb4940
--- /dev/null
+++ b/src/gui/canvas/split_line.h
@@ -0,0 +1,44 @@
+#pragma once
+
+// The line a design is split along, in section units.
+//
+// Splitting is how artwork is carried across a panel seam by hand: put the line
+// where the seam is, split, and move one of the two groups onto the neighbouring
+// panel. Game shapes cannot be cut in half, so a shape the line crosses is
+// copied into both groups - the clearance widens that overlap inwards, so a seam
+// that really sits a little further in than the line still has no bare strip.
+
+#include <QPointF>
+#include <QtMath>
+
+namespace gui {
+
+struct SplitLine {
+    double angleDeg = 0.0;   // counter-clockwise from the section's +x axis
+    double offset = 0.0;     // where the line sits along its own normal
+    double margin = 0.0;     // clearance: how far past the line each side reaches
+
+    QPointF normal() const {
+        const double radians = qDegreesToRadians(angleDeg);
+        return QPointF(-std::sin(radians), std::cos(radians));
+    }
+
+    QPointF direction() const {
+        const QPointF n = normal();
+        return QPointF(-n.y(), n.x());
+    }
+
+    QPointF anchor(const QPointF &near) const {
+        const QPointF n = normal();
+        const double d = signedDistance(near);
+        return QPointF(near.x() - n.x() * d, near.y() - n.y() * d);
+    }
+
+    // Negative is side A, positive is side B.
+    double signedDistance(const QPointF &point) const {
+        const QPointF n = normal();
+        return n.x() * point.x() + n.y() * point.y() - offset;
+    }
+};
+
+} // namespace gui

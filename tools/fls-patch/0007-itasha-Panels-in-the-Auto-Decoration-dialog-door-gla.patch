From edd7389dfec5dac02345a71697b8d4f0e4335704 Mon Sep 17 00:00:00 2001
From: duchil6063 <duchil6063@gmail.com>
Date: Thu, 3 Sep 2026 09:20:56 +0900
Subject: [PATCH 7/9] itasha: Panels in the Auto Decoration dialog - door
 glass, rear window, rear, front and windshield assignment

---
 src/gui/app/main_window_itasha.cpp | 91 ++++++++++++++++++++++++++++++
 src/gui/i18n.cpp                   | 34 +++++++++++
 2 files changed, 125 insertions(+)

diff --git a/src/gui/app/main_window_itasha.cpp b/src/gui/app/main_window_itasha.cpp
index 62befe5..9e2df71 100644
--- a/src/gui/app/main_window_itasha.cpp
+++ b/src/gui/app/main_window_itasha.cpp
@@ -144,6 +144,60 @@ const ArtworkRole kArtworkRoles[] = {
     {"pinned", "As is"},        // the decoration leaves it alone
 };
 
+// What each glass / bumper panel takes (engine/compose/facespec.py). Auto
+// follows the logos and the lettering - a logo row and a wordmark when there
+// are any, a crop of the hero otherwise (the rear and the rear window stay
+// empty). The rest pins that one panel.
+struct PanelMode {
+    const char *name;
+    const char *text;
+};
+
+struct PanelAssignment {
+    const char *face;           // recipe key (`faces`)
+    const char *text;           // row label
+    const PanelMode *modes;
+    int count;
+};
+
+const PanelMode kWindowModes[] = {
+    {"auto", "Auto (logo row and a phrase, else a portrait crop)"},
+    {"support", "Supporting artwork only"},
+    {"continue", "Continue the side artwork above the beltline"},
+    {"crop", "Portrait crop"},
+    {"empty", "Empty"},
+};
+const PanelMode kRearWindowModes[] = {
+    {"auto", "Auto (wordmark when there is lettering, else empty)"},
+    {"logos", "Logos and lettering"},
+    {"crop", "Bust crop"},
+    {"empty", "Empty"},
+};
+const PanelMode kRearModes[] = {
+    {"auto", "Auto (wordmark, logo row, colour planes)"},
+    {"logos", "Logos and lettering"},
+    {"crop", "Poster crop"},
+    {"empty", "Empty"},
+};
+const PanelMode kFrontModes[] = {
+    {"auto", "Auto (small logos, else an emblem crop)"},
+    {"logos", "Logos and lettering"},
+    {"crop", "Emblem crop"},
+    {"empty", "Empty"},
+};
+const PanelMode kWindshieldModes[] = {
+    {"auto", "Auto (lettering strip and a corner watermark)"},
+    {"logos", "Logos and lettering"},
+    {"empty", "Empty"},
+};
+const PanelAssignment kPanels[] = {
+    {"window", "Door glass:", kWindowModes, int(std::size(kWindowModes))},
+    {"rear_window", "Rear window:", kRearWindowModes, int(std::size(kRearWindowModes))},
+    {"rear", "Rear:", kRearModes, int(std::size(kRearModes))},
+    {"front", "Front:", kFrontModes, int(std::size(kFrontModes))},
+    {"windshield", "Windshield:", kWindshieldModes, int(std::size(kWindshieldModes))},
+};
+
 // The last text the user typed comes back the next time the dialog opens -
 // a name is typed once and tweaked many times.
 constexpr auto kItashaTextKey = "itasha/text";
@@ -772,6 +826,38 @@ void MainWindow::showItashaDecorationDialog() {
     sideLayout->addWidget(symmetryNote);
     layout->addWidget(sideGroup);
 
+    // ---- Panels ----
+    // What the glass and bumper panels take. Auto follows the logos and the
+    // lettering; the other values pin that panel. A recipe from before this
+    // dialog has no `faces` - every row starts on Auto then.
+    const QJsonObject faceState = state.value(QStringLiteral("faces")).toObject();
+    auto *panelGroup = new QGroupBox(i18n::t("Panels"), &dialog);
+    panelGroup->setToolTip(i18n::t(
+        "What the door glass, rear window, rear, front and windshield take. "
+        "Auto follows the logos and the lettering - a logo row and a wordmark "
+        "when there are any, a crop of the hero otherwise. Empty drops only "
+        "what is assigned here; the bands and motifs carried over from the "
+        "sides stay."));
+    auto *panelForm = new QFormLayout(panelGroup);
+    QVector<QPair<QString, QComboBox *>> panelBoxes;
+    for (const PanelAssignment &pa : kPanels) {
+        auto *box = new QComboBox(panelGroup);
+        for (int i = 0; i < pa.count; ++i) {
+            box->addItem(i18n::t(pa.modes[i].text), QString::fromLatin1(pa.modes[i].name));
+        }
+        pickCombo(box, faceState.value(QString::fromLatin1(pa.face)).toString(
+                           QStringLiteral("auto")));
+        panelForm->addRow(i18n::t(pa.text), box);
+        panelBoxes.push_back({QString::fromLatin1(pa.face), box});
+    }
+    auto *panelNote = new QLabel(i18n::t(
+        "Continue the side artwork copies the hero's part above the beltline "
+        "onto the door glass, the way Split at a Line does - the side keeps "
+        "its own cut."), panelGroup);
+    panelNote->setWordWrap(true);
+    panelForm->addRow(panelNote);
+    layout->addWidget(panelGroup);
+
     auto *buttons = new QDialogButtonBox(
         QDialogButtonBox::Ok | QDialogButtonBox::Cancel, &dialog);
     buttons->button(QDialogButtonBox::Ok)->setText(i18n::t("Compose"));
@@ -844,6 +930,11 @@ void MainWindow::showItashaDecorationDialog() {
           << QStringLiteral("--logo-placement") << logoPlacement->currentData().toString()
           << QStringLiteral("--symmetry")
           << (symmetry->isChecked() ? QStringLiteral("on") : QStringLiteral("off"));
+    // Panels last: `--face` takes a list, so nothing may follow it.
+    extra << QStringLiteral("--face");
+    for (const auto &pb : panelBoxes) {
+        extra << QStringLiteral("%1=%2").arg(pb.first, pb.second->currentData().toString());
+    }
     settings.endGroup();
     runItashaAction(QStringLiteral("decorate"), extra);
 }
